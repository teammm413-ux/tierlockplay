# TierLockPlay / Vegas Vault - Environment Configuration Template
# Copy this file to .env.local on your VPS or local machine and fill in your actual credentials.

# Database Configuration (MongoDB Atlas Cloud)
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/tierlockplay?retryWrites=true&w=majority

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_secure_password
ADMIN_EMAIL=admin@tierlockplay.com
JWT_SECRET=your_super_secret_jwt_key_random_string

# Twilio SMS OTP Configuration (for USA phone numbers)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Hostinger Business Email SMTP Configuration (Real-Time OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=verified@tierlockplay.com
SMTP_PASS=your_hostinger_email_password
SMTP_FROM="TierlockPlay Support" <verified@tierlockplay.com>

# App Base URL (e.g. https://app.tierlockplay.com on production VPS or http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=https://app.tierlockplay.com

# ================================================================
# Payment Gateway Configuration (Revsol / TapTapUp)
# ================================================================
REVSOL_MERCHANT_NAME=Revsol
REVSOL_VENDOR_EMAIL=your_vendor_email@gmail.com
REVSOL_MERCHANT_ID=your_merchant_id
REVSOL_SHARED_SECRET=your_shared_secret_key
REVSOL_WEBHOOK_SECRET=your_webhook_secret_key
REVSOL_BASE_URL=https://www.taptapup.xyz
REVSOL_MODE=production

# Payment Gateway Product IDs by Payment Channel
REVSOL_PRODUCT_ID_GOOGLE_APPLE_PAY=your_apple_google_pay_product_id
REVSOL_PRODUCT_ID_CASHAPP=your_cashapp_product_id
REVSOL_PRODUCT_ID_PAYPAL=your_paypal_product_id
REVSOL_PRODUCT_ID_CHIME=your_chime_product_id
REVSOL_PRODUCT_ID_BTC_LIGHTNING=your_btc_lightning_product_id

# Aliases for backward compatibility
TAPTAPUP_MERCHANT_NAME=Revsol
TAPTAPUP_MERCHANT_ID=your_merchant_id
TAPTAPUP_SECRET_KEY=your_shared_secret_key
TAPTAPUP_WEBHOOK_SECRET=your_webhook_secret_key
TAPTAPUP_BASE_URL=https://www.taptapup.xyz
TAPTAPUP_PRODUCT_ID=your_cashapp_product_id
TAPTAPUP_MIN_AMOUNT=1.00
TAPTAPUP_MODE=production

# TierLockPlay / Vegas Vault - Environment Configuration Template
# Copy this file to .env.local on your VPS or local machine and fill in your actual credentials.

# Database Configuration (MongoDB Atlas Cloud)
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/tierlockplay?retryWrites=true&w=majority

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_secure_password
ADMIN_EMAIL=admin@tierlockplay.com
JWT_SECRET=your_super_secret_jwt_key_random_string

# Twilio SMS OTP Configuration (for USA phone numbers)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Hostinger Business Email SMTP Configuration (Real-Time OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=verified@tierlockplay.com
SMTP_PASS=your_hostinger_email_password
SMTP_FROM="TierlockPlay Support" <verified@tierlockplay.com>

# App Base URL (e.g. https://app.tierlockplay.com on production VPS or http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=https://app.tierlockplay.com

# ================================================================
# Payment Gateway Configuration (Revsol / TapTapUp)
# ================================================================
REVSOL_MERCHANT_NAME=Revsol
REVSOL_VENDOR_EMAIL=your_vendor_email@gmail.com
REVSOL_MERCHANT_ID=your_merchant_id
REVSOL_SHARED_SECRET=your_shared_secret_key
REVSOL_WEBHOOK_SECRET=your_webhook_secret_key
REVSOL_BASE_URL=https://www.taptapup.com
REVSOL_MODE=production

# Payment Gateway Product IDs by Payment Channel
REVSOL_PRODUCT_ID_GOOGLE_APPLE_PAY=your_apple_google_pay_product_id
REVSOL_PRODUCT_ID_CASHAPP=your_cashapp_product_id
REVSOL_PRODUCT_ID_PAYPAL=your_paypal_product_id
REVSOL_PRODUCT_ID_CHIME=your_chime_product_id
REVSOL_PRODUCT_ID_BTC_LIGHTNING=your_btc_lightning_product_id

# Aliases for backward compatibility
TAPTAPUP_MERCHANT_NAME=Revsol
TAPTAPUP_MERCHANT_ID=your_merchant_id
TAPTAPUP_SECRET_KEY=your_shared_secret_key
TAPTAPUP_WEBHOOK_SECRET=your_webhook_secret_key
TAPTAPUP_BASE_URL=https://www.taptapup.com
TAPTAPUP_PRODUCT_ID=your_cashapp_product_id
TAPTAPUP_MIN_AMOUNT=1.00
TAPTAPUP_MODE=production

# ================================================================
# FastApi Game Platforms Integration (YAPI -61, API -60, apl -62)
# ================================================================
# Game 1: YAPI -61 (E-Star / Egames)
ESTAR_APP_ID=your_estar_app_id
ESTAR_APP_SECRET=your_estar_app_secret
ESTAR_AGENT_ACCOUNT=your_estar_agent_account
ESTAR_BASE_URL=https://papi.estar88.club

# Game 2: API -60 (Dragon Fury)
DRAGONFURY_APP_ID=your_dragonfury_app_id
DRAGONFURY_APP_SECRET=your_dragonfury_app_secret
DRAGONFURY_AGENT_ACCOUNT=your_dragonfury_agent_account
DRAGONFURY_BASE_URL=https://www.dragonfury.club

# Game 3: apl -62 (Ultra Thunder)
ULTRATHUNDER_APP_ID=your_ultrathunder_app_id
ULTRATHUNDER_APP_SECRET=your_ultrathunder_app_secret
ULTRATHUNDER_AGENT_ACCOUNT=your_ultrathunder_agent_account
ULTRATHUNDER_BASE_URL=https://www.ultrathunder.mobi

# ================================================================
# Fire Kirin Game Platform Integration (Fire Kirin Game API)
# ================================================================
FIREKIRIN_AGENT_NAME=AnjumxFKCO
FIREKIRIN_AGENT_PASSWORD=your_firekirin_agent_password
FIREKIRIN_BASE_URL=https://firekirin.xyz:8034
FIREKIRIN_GAME_URL=https://play.firekirin.xyz

# ================================================================
# Juwa 2.0 Game Platform Integration (Juwa 2.0 API)
# ================================================================
JUWA2_AGENT_ID=9993
JUWA2_SECRET_KEY=your_juwa2_api_secret_key
JUWA2_BASE_URL=https://apiinterface.juwa2.xin
JUWA2_GAME_URL=https://m.juwa2.com/

# ================================================================
# VPS / Production (whitelist this IP with game providers)
# ================================================================
# Hostinger VPS for https://app.tierlockplay.com
SERVER_PUBLIC_IP=179.236.244.219

# ================================================================
# Agent Vault Game APIs (Bearer token after agent login)
# Each game needs AGENT USERNAME + PASSWORD from your game distributor.
# Set these in .env.local on the VPS: /path/to/app/.env.local
# ================================================================

# Cash Frenzy — Platform name in admin: "Cash Frenzy"
CASHFRENZY_AGENT_USERNAME=your_cashfrenzy_agent_username
CASHFRENZY_AGENT_PASSWORD=your_cashfrenzy_agent_password
CASHFRENZY_BASE_URL=https://agentserver.cashfrenzy777.com

# Cash Machine — Platform name: "Cash Machine"
CASHMACHINE_AGENT_USERNAME=your_cashmachine_agent_username
CASHMACHINE_AGENT_PASSWORD=your_cashmachine_agent_password
CASHMACHINE_BASE_URL=https://agentserver.cashmachine777.com

# Lucky Stars — Platform name: "Lucky Stars"
LUCKYSTARS_AGENT_USERNAME=your_luckystars_agent_username
LUCKYSTARS_AGENT_PASSWORD=your_luckystars_agent_password
LUCKYSTARS_BASE_URL=https://agent.luckystars.games

# Mafia — Platform name: "Mafia"
MAFIA_AGENT_USERNAME=your_mafia_agent_username
MAFIA_AGENT_PASSWORD=your_mafia_agent_password
MAFIA_BASE_URL=https://agentserver.mafia77777.com

# Mr All In One — Platform name: "Mr All In One"
MRALLINONE_AGENT_USERNAME=your_mrallinone_agent_username
MRALLINONE_AGENT_PASSWORD=your_mrallinone_agent_password
MRALLINONE_BASE_URL=https://agentserver.mrallinone777.com

# Noble — Platform name: "Noble" (withdraw API also sends winning balance)
NOBLE_AGENT_USERNAME=your_noble_agent_username
NOBLE_AGENT_PASSWORD=your_noble_agent_password
NOBLE_BASE_URL=https://agentserver.noble777.com

# Vegas Roll — Platform name: "Vegas Roll"
VEGASROLL_AGENT_USERNAME=your_vegasroll_agent_username
VEGASROLL_AGENT_PASSWORD=your_vegasroll_agent_password
VEGASROLL_BASE_URL=https://backend.vegas-roll.com

# ================================================================
# MANUAL PLATFORMS (no .env keys — admin approves in dashboard)
